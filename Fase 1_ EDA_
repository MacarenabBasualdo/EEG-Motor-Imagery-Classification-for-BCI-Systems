ifier\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m=\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_load_file\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mfile_path\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/content/drive/MyDrive/BCI-MENTORIA-UNC/src/eeg_datasets/preprocessed_dataset.py\u001b[0m in \u001b[0;36m_load_file\u001b[0;34m(self, path)\u001b[0m\n\u001b[1;32m    174\u001b[0m         \u001b[0;34m\"\"\"Cargador con filtrado de canales integrado.\"\"\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    175\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0mpath\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mendswith\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m'.npy'\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--\u003e 176\u001b[0;31m             \u001b[0mdata\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mnp\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    177\u001b[0m             \u001b[0;31m# Si es data (3D: trials, channels, samples) y hay canales seleccionados\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    178\u001b[0m             \u001b[0;32mif\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mselected_channels\u001b[0m \u001b[0;32mis\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0;32mNone\u001b[0m \u001b[0;32mand\u001b[0m \u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mdata\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mshape\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;34m==\u001b[0m \u001b[0;36m3\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.12/dist-packages/numpy/lib/_npyio_impl.py\u001b[0m in \u001b[0;36mload\u001b[0;34m(file, mmap_mode, allow_pickle, fix_imports, encoding, max_header_size)\u001b[0m\n\u001b[1;32m    460\u001b[0m         \u001b[0m_ZIP_SUFFIX\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0;34mb'PK\\x05\\x06'\u001b[0m  \u001b[0;31m# empty zip files start with this\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    461\u001b[0m         \u001b[0mN\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mlen\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mformat\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mMAGIC_PREFIX\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--\u003e 462\u001b[0;31m         \u001b[0mmagic\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mfid\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mread\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mN\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    463\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0mmagic\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    464\u001b[0m             \u001b[0;32mraise\u001b[0m \u001b[0mEOFError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m\"No data left in file\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mKeyboardInterrupt\u001b[0m: "]}],"source":["# --- Tomamos un sujeto de ejemplo para inspeccionar la forma del tensor crudo ---\n","sujeto_ejemplo = lista_sujetos[0]\n","X_ejemplo, Y_ejemplo, metadata_ejemplo = dataset.flatten_pool_data(subject_ids=[sujeto_ejemplo])\n","\n","n_ensayos_ej, n_canales_ej, n_tiempos_ej = X_ejemplo.shape\n","duracion_seg = n_tiempos_ej / SFREQ\n","\n","print(f\"--- Dimensión del tensor de EEG (sujeto de ejemplo: {sujeto_ejemplo}) ---\")\n","print(f\"Forma (shape): {X_ejemplo.shape}\")\n","print(f\"  Eje 0 -\u003e Ensayos (trials):        {n_ensayos_ej}\")\n","print(f\"  Eje 1 -\u003e Canales EEG:              {n_canales_ej}  {CHANNELS}\")\n","print(f\"  Eje 2 -\u003e Muestras temporales:      {n_tiempos_ej}  (a {SFREQ} Hz -\u003e {duracion_seg:.2f} s por ensayo)\")\n","\n","# --- Dimensión agregada de toda la base de datos (los 60 sujetos, ensayos pooleados) ---\n","X_todos, Y_todos, metadata_todos = dataset.flatten_pool_data(subject_ids=lista_sujetos)\n","\n","n_ensayos_tot, n_canales_tot, n_tiempos_tot = X_todos.shape\n","\n","print(f\"\\n--- Dimensión del tensor combinado (todos los sujetos, {DB_SELECCIONADA}) ---\")\n","print(f\"Forma (shape): {X_todos.shape}\")\n","print(f\"  Eje 0 -\u003e Ensayos totales (todos los sujetos y ambas clases): {n_ensayos_tot}\")\n","print(f\"  Eje 1 -\u003e Canales EEG: {n_canales_tot}  {CHANNELS}\")\n","print(f\"  Eje 2 -\u003e Muestras temporales por ensayo: {n_tiempos_tot} (a {SFREQ} Hz -\u003e {n_tiempos_tot/SFREQ:.2f} s)\")\n","\n","print(f\"\\nResumen: cada ensayo es una ventana de EEG de {n_canales_tot} canales x \"\n","      f\"{n_tiempos_tot} muestras ({n_tiempos_tot/SFREQ:.2f} s a {SFREQ} Hz), \"\n","      f\"y en total tenemos {n_ensayos_tot} ensayos etiquetados (Mano Izquierda / Mano Derecha) \"\n","      f\"provenientes de {len(lista_sujetos)} sujetos.\")"]},{"cell_type":"markdown","id":"z0GS2UlUI4xs","metadata":{"id":"z0GS2UlUI4xs"},"source":["## Definición de métodos de extracción"]},{"cell_type":"code","execution_count":null,"id":"yYtzGuYCI4KW","metadata":{"id":"yYtzGuYCI4KW"},"outputs":[],"source":["def feature_total_power(X):\n","    \"\"\"Recibe [Ensayos, Canales, Tiempo]. Retorna [Ensayos, Canales].\"\"\"\n","    assert X.ndim == 3, \"El tensor de entrada debe ser estrictamente tridimensional [Ensayos, Canales, Tiempo]\"\n","    return np.mean(np.square(X), axis=-1)\n","\n","\n","def feature_band_power(X, sfreq=128, fbands=[(4,8), (8,12), (12,16), (16,20), (20,24), (28,30)]):\n","    \"\"\"Calcula la potencia absoluta por bandas de frecuencia usando Welch. Retorna [Ensayos, Canales*Bandas].\"\"\"\n","    assert X.ndim == 3, \"El tensor de entrada debe ser estrictamente tridimensional [Ensayos, Canales, Tiempo]\"\n","    n_ensayos, n_canales, n_tiempos = X.shape\n","    n_bandas = len(fbands)\n","\n","    frecuencias, psd = welch(X, fs=sfreq, axis=-1, nperseg=int(sfreq))\n","\n","    X_features = np.zeros((n_ensayos, n_canales * n_bandas))\n","\n","    for idx_banda, (f_min, f_max) in enumerate(fbands):\n","        indices_banda = (frecuencias \u003e= f_min) \u0026 (frecuencias \u003c= f_max)\n","        potencia_banda = np.mean(psd[:, :, indices_banda], axis=-1)\n","        for idx_canal in range(n_canales):\n","            columna_idx = idx_canal * n_bandas + idx_banda\n","            X_features[:, columna_idx] = potencia_banda[:, idx_canal]\n","\n","    assert X_features.shape[0] == n_ensayos, \"Error: La cantidad de ensayos se modificó.\"\n","    assert X_features.ndim == 2, f\"Error: Se esperaba una matriz 2D, pero se obtuvo {X_features.shape}\"\n","    return X_features\n","\n","\n","def feature_kurtosis(X):\n","    \"\"\"Calcula la Kurtosis por canal. Retorna: [Ensayos, Canales]\"\"\"\n","    assert X.ndim == 3\n","    return kurtosis(X, axis=-1)\n","\n","\n","def feature_skewness(X):\n","    \"\"\"Calcula el Skewness (Asimetría) por canal. Retorna: [Ensayos, Canales]\"\"\"\n","    assert X.ndim == 3\n","    return skew(X, axis=-1)\n","\n","\n","def feature_katz_fractal_dim(X):\n","    \"\"\"Calcula la Dimensión Fractal de Katz por canal. Retorna: [Ensayos, Canales]\"\"\"\n","    assert X.ndim == 3\n","    n_ensayos, n_canales, n_tiempos = X.shape\n","    out = np.zeros((n_ensayos, n_canales))\n","\n","    for e in range(n_ensayos):\n","        for c in range(n_canales):\n","            senal = X[e, c, :]\n","            L = np.sum(np.abs(np.diff(senal)))\n","            d = np.max(np.abs(senal - senal[0]))\n","            katz = np.log10(n_tiempos) / (np.log10(n_tiempos) + np.log10(d / (L + 1e-8)) + 1e-8)\n","            out[e, c] = katz\n","    return out\n","\n","\n","def feature_autoregressive_coefs(X, order=4):\n","    \"\"\"Calcula los Coeficientes AR del orden seteado por canal. Retorna: [Ensayos, Canales * order]\"\"\"\n","    assert X.ndim == 3\n","    n_ensayos, n_canales, n_tiempos = X.shape\n","    out = np.zeros((n_ensayos, n_canales * order))\n","\n","    for e in range(n_ensayos):\n","        for c in range(n_canales):\n","            senal = X[e, c, :]\n","            r = np.correlate(senal, senal, mode='full')[n_tiempos-1 : n_tiempos + order + 1]\n","            r /= r[0]\n","\n","            R = np.zeros((order, order))\n","            for i in range(order):\n","                R[i, :] = r[abs(np.arange(order) - i)]\n","            b = r[1:order+1]\n","\n","            try:\n","                ar_coefs = np.linalg.solve(R, b)\n","            except np.linalg.LinAlgError:\n","                ar_coefs = np.zeros(order)\n","\n","            out[e, c*order : c*order + order] = ar_coefs\n","    return out\n","\n","\n","def feature_permutation_entropy(X, order=3, delay=1):\n","    \"\"\"Calcula la Entropía de Permutación por canal. Retorna: [Ensayos, Canales]\"\"\"\n","    assert X.ndim == 3\n","    n_ensayos, n_canales, n_tiempos = X.shape\n","    out = np.zeros((n_ensayos, n_canales))\n","\n","    for e in range(n_ensayos):\n","        for c in range(n_canales):\n","            x = X[e, c, :]\n","            n_words = n_tiempos - (order - 1) * delay\n","            words = np.zeros((n_words, order))\n","            for i in range(order):\n","                words[:, i] = x[i * delay : i * delay + n_words]\n","\n","            orders = np.argsort(words, axis=1)\n","            _, counts = np.unique(orders, axis=0, return_counts=True)\n","            probs = counts / counts.sum()\n","            pe = -np.sum(probs * np.log2(probs))\n","            out[e, c] = pe / np.log2(math.factorial(order))   # \u003c- fix: math, no np.math\n","    return out\n","\n","\n","def feature_cross_correlation(X):\n","    \"\"\"Calcula la Correlación Cruzada (lag 0) para pares C3-Cz, C4-Cz, C3-C4. Retorna: [Ensayos, 3]\"\"\"\n","    assert X.ndim == 3\n","    n_ensayos, _, _ = X.shape\n","    out = np.zeros((n_ensayos, 3))\n","    pares = [(0, 1), (2, 1), (0, 2)]\n","\n","    for e in range(n_ensayos):\n","        for idx_par, (chA, chB) in enumerate(pares):\n","            corr = np.corrcoef(X[e, chA, :], X[e, chB, :])[0, 1]\n","            out[e, idx_par] = 0.0 if np.isnan(corr) else corr\n","    return out\n","\n","\n","def feature_magnitude_squared_coherence(X, sfreq=128, fbands=[(8, 12), (12, 30)]):\n","    \"\"\"Calcula la Coherencia Espectral (MSC) promediada por bandas para los 3 pares. Retorna: [Ensayos, 3 * len(fbands)]\"\"\"\n","    assert X.ndim == 3\n","    n_ensayos, _, _ = X.shape\n","    n_bandas = len(fbands)\n","    out = np.zeros((n_ensayos, 3 * n_bandas))\n","    pares = [(0, 1), (2, 1), (0, 2)]\n","\n","    for e in range(n_ensayos):\n","        col_idx = 0\n","        for chA, chB in pares:\n","            f, msc = coherence(X[e, chA, :], X[e, chB, :], fs=sfreq, nperseg=int(sfreq))\n","            for f_min, f_max in fbands:\n","                idx_b = (f \u003e= f_min) \u0026 (f \u003c= f_max)\n","                out[e, col_idx] = np.mean(msc[idx_b]) if np.any(idx_b) else 0.0\n","                col_idx += 1\n","    return out\n","\n","\n","def feature_phase_locking_value(X):\n","    \"\"\"Calcula el PLV (Sincronización de Fase) para los 3 pares. Retorna: [Ensayos, 3]\"\"\"\n","    assert X.ndim == 3\n","    n_ensayos, _, _ = X.shape\n","    out = np.zeros((n_ensayos, 3))\n","    pares = [(0, 1), (2, 1), (0, 2)]\n","\n","    for e in range(n_ensayos):\n","        for idx_par, (chA, chB) in enumerate(pares):\n","            faseA = np.angle(hilbert(X[e, chA, :]))\n","            faseB = np.angle(hilbert(X[e, chB, :]))\n","            out[e, idx_par] = np.abs(np.mean(np.exp(1j * (faseA - faseB))))\n","    return out"]},{"cell_type":"markdown","id":"uu9wrZFQJLyG","metadata":{"id":"uu9wrZFQJLyG"},"source":["## Pipeline_config"]},{"cell_type":"code","execution_count":null,"id":"bVxeIFCPJNk2","metadata":{"id":"bVxeIFCPJNk2"},"outputs":[],"source":["pipeline_config = {\n","    \"potencia_total\":      {\"active\": True, \"method\": feature_total_power, \"params\": {}},\n","    \"bandas_frecuencia\":   {\"active\": True, \"method\": feature_band_power, \"params\": {\"sfreq\": 128, \"fbands\": [(4,8),(8,12),(12,16),(16,20),(20,24),(28,30)]}},\n","    \"kurtosis\":            {\"active\": True, \"method\": feature_kurtosis, \"params\": {}},\n","    \"skewness\":            {\"active\": True, \"method\": feature_skewness, \"params\": {}},\n","    \"katz_fractal\":        {\"active\": True, \"method\": feature_katz_fractal_dim, \"params\": {}},\n","    \"coeficientes_ar\":     {\"active\": True, \"method\": feature_autoregressive_coefs, \"params\": {\"order\": 10}},\n","    \"entropia_perm\":       {\"active\": True, \"method\": feature_permutation_entropy, \"params\": {\"order\": 3}},\n","    \"correlacion_cruzada\": {\"active\": True, \"method\": feature_cross_correlation, \"params\": {}},\n","    \"coherencia_msc\":      {\"active\": True, \"method\": feature_magnitude_squared_coherence, \"params\": {\"sfreq\": 128, \"fbands\": [(8,12),(12,30)]}},\n","    \"plv_fase\":            {\"active\": True, \"method\": feature_phase_locking_value, \"params\": {}},\n","}"]},{"cell_type":"markdown","id":"43LaV_cpJTN_","metadata":{"id":"43LaV_cpJTN_"},"source":["## Loop de extracción (todos los sujetos, formato largo, con guardado por sujeto)"]},{"cell_type":"code","execution_count":null,"id":"LERxYC1oJXVm","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":90052,"status":"ok","timestamp":1785331422229,"user":{"displayName":"JENIFER MACARENA BASUALDO","userId":"09586911832758242668"},"user_tz":180},"id":"LERxYC1oJXVm","outputId":"b26121e6-70cb-47ce-be49-94f964e4b5a1"},"outputs":[{"name":"stdout","output_type":"stream","text":["↺ [1] -\u003e ya existía, cargado desde checkpoint\n","↺ [2] -\u003e ya existía, cargado 