for c in df_features_wide.columns if c not in columnas_no_features]\n","\n","# --- Tabla resumen: media y std por sujeto, para cada columna feature_canal ---\n","df_stats_sujeto = df_features_wide.groupby('subject_id')[columnas_features_todas].agg(['mean', 'std'])\n","df_stats_sujeto.columns = [f\"{feat}_{stat}\" for feat, stat in df_stats_sujeto.columns]\n","df_stats_sujeto = df_stats_sujeto.reset_index()\n","\n","print(f\"Tabla de medias/std por sujeto: {df_stats_sujeto.shape[0]} sujetos x {df_stats_sujeto.shape[1]-1} columnas (mean+std por cada feature_canal)\")\n","display(df_stats_sujeto)\n","\n","# Ejemplo enfocado en una sola feature para lectura rápida (potencia_total, los 3 canales)\n","cols_ejemplo = [c for c in df_stats_sujeto.columns if c.startswith('potencia_total')]\n","display(df_stats_sujeto[['subject_id'] + cols_ejemplo])\n","\n","\n","# Función reutilizable: boxplot + stripplot por sujeto y canal\n","def plot_boxplot_strip_por_sujeto(df_wide, feature_base, muestrear_sujetos=True, n_muestra=15, seed=42):\n","    columnas_features = [col for col in df_wide.columns if col.startswith(feature_base)]\n","    columnas_metadata = ['subject_id', 'Clase_Nombre', 'label']\n","\n","    if not columnas_features:\n","        raise ValueError(f\"No se encontraron columnas que comiencen con '{feature_base}'.\")\n","\n","    df_sub = df_wide[columnas_metadata + columnas_features].copy()\n","\n","    if muestrear_sujetos:\n","        rng = np.random.default_rng(seed)\n","        sujetos_todos = df_sub['subject_id'].unique()\n","        sujetos_muestra = sorted(rng.choice(sujetos_todos, size=min(n_muestra, len(sujetos_todos)), replace=False))\n","        df_sub = df_sub[df_sub['subject_id'].isin(sujetos_muestra)]\n","        print(f\"Mostrando {len(sujetos_muestra)} sujetos (muestra aleatoria, seed={seed})\")\n","    else:\n","        print(f\"Mostrando los {df_sub['subject_id'].nunique()} sujetos completos\")\n","\n","    df_long = pd.melt(df_sub, id_vars=columnas_metadata, value_vars=columnas_features,\n","                       var_name='Feature_Canal', value_name='Valor')\n","    df_long['Canal'] = df_long['Feature_Canal'].apply(lambda x: x.split('_')[-1])\n","\n","    g = sns.catplot(\n","        data=df_long, x='subject_id', y='Valor', hue='Clase_Nombre', col='Canal',\n","        kind='box', fliersize=0, boxprops=dict(alpha=0.6), palette='Set2',\n","        height=5, aspect=1.6, sharey=True\n","    )\n","    for ax, canal in zip(g.axes.flat, df_long['Canal'].unique()):\n","        df_canal = df_long[df_long['Canal'] == canal]\n","        sns.stripplot(data=df_canal, x='subject_id', y='Valor', hue='Clase_Nombre',\n","                       palette='Set2', dodge=True, alpha=0.4, size=3, jitter=0.2, ax=ax, legend=False)\n","        ax.tick_params(axis='x', rotation=90)\n","\n","    g.fig.suptitle(f\"Distribución de {feature_base.replace('_',' ').title()} por Canal y Sujeto\",\n","                    y=1.03, fontsize=14, fontweight='bold')\n","    g.set_axis_labels(\"Identificador del Sujeto\", \"Magnitud / Valor de la Métrica\")\n","    plt.tight_layout()\n","    plt.show()\n","\n","\n","# --- Llamamos la función para varias features representativas ---\n","# muestrear_sujetos=False porque ya filtramos a 14 sujetos específicos (todos entran en el gráfico)\n","for feature_base in [\"potencia_total\", \"kurtosis\", \"skewness\"]:\n","    plot_boxplot_strip_por_sujeto(df_features_wide, feature_base, muestrear_sujetos=False)"]},{"cell_type":"markdown","id":"vXcUzFw8_V1b","metadata":{"id":"vXcUzFw8_V1b"},"source":["Las gráficas anteriores constituyen una primera visualización exploratoria de la distribución de 3 de las features calculadas (Potencia Total, Kurtosis y Skewness), para los 14 sujetos seleccionados y los 3 canales (C3, C4, Cz).\n","\n","En Potencia Total se observa una variabilidad marcada entre sujetos: las cajas se desplazan notablemente de un sujeto a otro, indicando que el nivel general de esta métrica difiere según la persona. En Kurtosis y Skewness, en cambio, las cajas se mantienen relativamente similares y compactas entre sujetos, mientras que la dispersión se concentra dentro de cada sujeto (variabilidad intra-sujeto), sugiriendo que estas dos métricas son menos discriminativas a nivel poblacional pero más sensibles a la variabilidad trial a trial."]},{"cell_type":"markdown","id":"uJd6oB5CVMmd","metadata":{"id":"uJd6oB5CVMmd"},"source":["# Visualización del Espacio de Características:\n"]},{"cell_type":"markdown","id":"OPDZOffSIlHD","metadata":{"id":"OPDZOffSIlHD"},"source":["## PCA"]},{"cell_type":"code","execution_count":null,"id":"MHEPhAcyE-4-","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":405},"executionInfo":{"elapsed":923,"status":"ok","timestamp":1785331973048,"user":{"displayName":"JENIFER MACARENA BASUALDO","userId":"09586911832758242668"},"user_tz":180},"id":"MHEPhAcyE-4-","outputId":"cb377f59-af88-471c-97a7-a21927fa0c95"},"outputs":[{"name":"stdout","output_type":"stream","text":["### Aplicando PCA completo (todas las componentes) para el scree plot ###\n"]},{"data":{"image/png":"\n","text/plain":["\u003cFigure size 1200x600 with 1 Axes\u003e"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Varianza explicada por las primeras 5 componentes individualmente: [0.1863005  0.11349104 0.10174978 0.08900721 0.05497166]\n","Dimensión original (cantidad de features): 75\n","Componentes necesarias para 95% de varianza: 34\n","Componentes necesarias para 70% de varianza: 9\n"]}],"source":["# --- PCA con TODAS las componentes (necesario para el scree plot completo) ---\n","print(\"### Aplicando PCA completo (todas las componentes) para el scree plot ###\")\n","pca_full = PCA(random_state=42)\n","pca_full.fit(X_scaled)\n","\n","cum_var = np.cumsum(pca_full.explained_variance_ratio_)\n","\n","# --- Scree plot: varianza explicada POR CADA componente (no acumulada) ---\n","plt.figure(figsize=(12, 6))\n","n_componentes_mostrar = 30\n","var_ratio = pca_full.explained_variance_ratio_[:n_componentes_mostrar]\n","\n","plt.bar(range(1, len(var_ratio)+1), var_ratio, alpha=0.7, color='steelblue', label='Varianza individual')\n","plt.plot(range(1, len(var_ratio)+1), np.cumsum(var_ratio), marker='o', color='darkorange',\n","         markersize=4, label='Varianza acumulada (primeras 30 comp.)')\n","plt.axhline(y=0.95, color='r', linestyle='--', alpha=0.5, label='95% de varianza')\n","plt.axhline(y=0.7, color='g', linestyle='--', alpha=0.5, label='70% de varianza')\n","plt.title('Scree Plot — Varianza Explicada por Componente Principal', fontsize=15, fontweight='bold')\n","plt.xlabel('Componente Principal')\n","plt.ylabel('Proporción de Varianza Explicada')\n","plt.legend()\n","plt.grid(True, linestyle='--', alpha=0.4)\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"Varianza explicada por las primeras 5 componentes individualmente: {pca_full.explained_variance_ratio_[:5]}\")\n","print(f\"Dimensión original (cantidad de features): {X_scaled.shape[1]}\")\n","print(f\"Componentes necesarias para 95% de varianza: {np.argmax(cum_var \u003e= 0.95) + 1}\")\n","print(f\"Componentes necesarias para 70% de varianza: {np.argmax(cum_var \u003e= 0.7) + 1}\")"]},{"cell_type":"markdown","id":"EY0jwaNJWar7","metadata":{"id":"EY0jwaNJWar7"},"source":["### Lectura del gráfico\n","\n","1. Solapamiento total entre clases: los puntos rojos (Mano Derecha) y verdes (Mano Izquierda) están completamente mezclados, sin ningún patrón de agrupamiento visible.\n","2. Varianza explicada muy baja para 2D: PC1 (17.83%) + PC2 (11.27%) = solo ~29% de la varianza total. Esto es consistente con lo que se ve, con tan poca información capturada en el plano, es totalmente esperable que las clases no se separen a simple vista.\n","3. La curva de varianza acumulada confirma que hacen falta bastantes más componentes para llegar al 95% . Esto tiene sentido: porque se tiene muchas features (PSD por banda, AR de orden 10 por canal, PLV, MSC, etc.), y ninguna combinación lineal de solo 2 ejes va a capturar toda esa variabilidad.\n","\n","_Criterio adoptado:_\n","\n","\n","Se opta por el criterio de 70% de varianza explicada en lugar del 95% habitual porque el objetivo de esta reducción es preparar los datos para clasificación (no reconstrucción de la señal). El scree plot muestra un codo marcado en las primeras componentes y un aplanamiento rápido de la curva, indicando que las componentes adicionales aportan varianza residual de bajo valor discriminativo. Retener el 95% implicaría conservar ~30+ de las ~90 features originales, anulando en la práctica el beneficio de la reducción de dimensionalidad y aumentando el riesgo de sobreajuste dado el tamaño limitado de la muestra por sujeto. El criterio del 70% ofrece un compromiso razonable entre simplicidad del modelo y retención de información.\n","\n","Sin embargo, esto es una observación a nivel de PCA lineal. Las caracteristicas actuales no son suficientes para observar una separacion lineal clara; es por ello que se implementaran alternativas cómo t-SNE y/o UMAP para explorar la relacion de estas estructuras más complejas y de alta dimensión."]},{"cell_type":"markdown","id":"hQ15t-LzW12T","metadata":{"id":"hQ15t-LzW12T"},"source":["## - t-SNE (no lineal)"]},{"cell_type":"code","execution_count":null,"id":"s_ZHnBQlXCUl","metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":819},"executionInfo":{"elapsed":336888,"status":"ok","timestamp":1784561677506,"user":{"displayName":"JENIFER MACARENA BASUALDO","userId":"09586911832758242668"},"user_tz":180},"id":"s_ZHnBQlXCUl"},"outputs":[{"name":"stdout","output_type":"stream","text":["### Aplicando t-SNE (2 componentes) ###\n"]},{"data":{"image/png":"\n","text/plain":["\u003cFigure size 1000x800 with 1 Axes\u003e"]},"metadata":{},"output_type":"display_data"}],"source":["from sklearn.manifold import TSNE\n","\n","print(\"### Aplicando t-SNE (2 componentes) ###\")\n","\n","tsne = TSNE(n_components=2, random_state=42, perplexity=30, learning_rate=200, max_iter=1000)\n","X_tsne = tsne.fit_transform(X_scaled)\n","\n","df_tsne = pd.DataFrame(X_tsne, columns=['Componente t-SNE 1', 'Componente t-SNE 2'])\n","df_tsne['Clase'] = y_pca.reset_index(drop=True)\n","\n","plt.figure(figsize=(10, 8))\n","sns.scatterplot(\n","    x='Componente t-SNE 1', y='Componente t-SNE 2', hue='Clase',\n","    data=df_tsne, s=40, alpha=0.5,\n","    palette={'Mano Izquierda': 'crimson', 'Mano Derecha': 'teal'}\n",")\n","plt.title('Espacio de Características Reducido con t-SNE — 60 sujetos', fontsize=15, fontweight='bold')\n","plt.xlabel('Componente t-SNE 1')\n","plt.ylabel('Componente t-SNE 2')\n","plt.grid(True, linestyle='--', alpha=0.6)\n","plt.legend(title='Condición')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"Z2uEQeaZYjU5","metadata":{"id":"Z2uEQeaZYjU5"},"source":["## - UMAP (no lineal)"]},{"cell_type":"code","execution_count":null,"id":"UReLsUuYYmTj","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":856},"executionInfo":{"elapsed":118834,"status":"ok","timestamp":1784552825562,"user":{"displayName":"JENIFER MACARENA BASUALDO","userId":"09586911832758242668"},"user_tz":180},"id":"UReLsUuYYmTj","outputId":"ca1b73f2-1a9a-42b9-fe8b-c41aaf19af48"},"outputs":[{"name":"stdout","output_type":"stream","text":["### Aplicando UMAP (2 componentes) ###\n"]},{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/umap/umap_.py:1952: UserWarning: n_jobs value 1 overridden to 1 by setting random_state. Use no seed for parallelism.\n","  warn(\n"]},{"data":{"image/png":"\n","text/plain":["\u003cFigure size 1000x800 with 1 Axes\u003e"]},"metadata":{},"output_type":"display_data"}],"source":["try:\n","    import umap\n","except ImportError:\n","    !pip install umap-learn -q\n","    import umap\n","\n","print(\"### Aplicando UMAP (2 componentes) ###\")\n","\n","umapper = umap.UMAP(n_components=2, random_state=42, n_neighbors=50, min_dist=0.01)\n","X_umap = umapper.fit_transform(X_scaled)\n","\n","df_umap = pd.DataFrame(X_umap, columns=['Componente UMAP 1', 'Componente UMAP 2'])\n","df_umap['Clase'] = y_pca.reset_index(drop=True)\n","\n","plt.figure(figsize=(10, 8))\n","sns.scatterplot(\n","    x='Componente UMAP 1', y='Componente UMAP 2', hue='Clase',\n","    data=df_umap, s=40, alpha=0.5,\n","    palette={'Mano Izquierda': 'crimson', 'Mano Derecha': 'teal'}\n",")\n","plt.title('Espacio de Características Reducido con UMAP — 60 sujetos', fontsize=15, fontweight='bold')\n","plt.xlabel('Componente UMAP 1')\n","plt.ylabel('Componente UMAP 2')\n","plt.grid(True, linestyle='--', alpha=0.6)\n","plt.legend(title='Condición')\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"oLU85BHQZtUO","metadata":{"id":"oLU85BHQZtUO"},"source":["Las clases motoras (izquierda/derecha) no son separables en el espacio de características combinado, ni linealmente (PCA) ni de forma no lineal por vecindad (t-SNE/UMAP), al menos no como agregado poblacional de 60 sujetos. Lo que sí emerge con fuerza es una estructura de agrupamiento (probablemente por sujeto)."]},{"cell_type":"markdown","id":"h5Flhk45NUXQ","metadata":{"id":"h5Flhk45NUXQ"},"source":["##"]},{"cell_type":"markdown","id":"5qlLAS6u9csY","metadata":{"id":"5qlLAS6u9csY"},"source":["## Estadística Aplicada y Ética del Pipeline\n","\n","\n","###  Parte A: Criterio Estadístico de Discriminación\n","\n","Primero, se realizará un a prueba de normalidad para observar la distribución de los datos. La prueba elegida es la de Shapiro-Wilk ya que es el estándar recomendado cuando se estiman los parámetros de la muestra (que es exactamente este caso), es más potente, y las implementaciones actuales lo soportan bien hasta miles de muestras."]},{"cell_type":"markdown","id":"sguH1CU2SO-6","metadata":{"id":"sguH1CU2SO-6"},"source":["### Test de normalidad por feature y por clase"]},{"cell_type":"code",