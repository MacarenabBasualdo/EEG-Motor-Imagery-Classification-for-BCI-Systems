               False\n","4       AR_coef1_C4                   False\n","..              ...                     ...\n","70  power_band_6_C4                   False\n","71  power_band_6_Cz                   False\n","72      skewness_C3                   False\n","73      skewness_C4                   False\n","74      skewness_Cz                   False\n","\n","[75 rows x 2 columns]"]},"metadata":{},"output_type":"display_data"}],"source":["from scipy import stats\n","\n","# --- Columnas a evaluar: todas las features numéricas ---\n","columnas_no_features = ['subject_id', 'trial_idx', 'label', 'Clase_Nombre']\n","columnas_features_todas = [c for c in df_features_wide.columns if c not in columnas_no_features]\n","\n","ALPHA = 0.05\n","N_MAX_SHAPIRO = 5000\n","SEED = 42\n","rng = np.random.default_rng(SEED)\n","\n","registros_normalidad = []\n","\n","for feat in columnas_features_todas:\n","    for clase in df_features_wide['Clase_Nombre'].unique():\n","        valores = df_features_wide.loc[df_features_wide['Clase_Nombre'] == clase, feat].dropna().values\n","\n","        if len(valores) \u003e N_MAX_SHAPIRO:\n","            valores_test = rng.choice(valores, size=N_MAX_SHAPIRO, replace=False)\n","        else:\n","            valores_test = valores\n","\n","        stat_sw, p_sw = stats.shapiro(valores_test)\n","\n","        registros_normalidad.append({\n","            'feature': feat,\n","            'clase': clase,\n","            'n': len(valores),\n","            'shapiro_stat': stat_sw,\n","            'p_value_shapiro': p_sw,\n","            'es_normal': p_sw \u003e ALPHA,\n","        })\n","\n","df_normalidad = pd.DataFrame(registros_normalidad)\n","\n","df_normalidad_resumen = (\n","    df_normalidad.groupby('feature')['es_normal']\n","    .all()\n","    .reset_index()\n","    .rename(columns={'es_normal': 'normal_en_ambas_clases'})\n",")\n","\n","print(f\"Features evaluadas: {df_normalidad_resumen.shape[0]}\")\n","print(f\"Features con distribución normal en ambas clases: {df_normalidad_resumen['normal_en_ambas_clases'].sum()}\")\n","print(f\"Features NO normales (al menos en una clase): {(~df_normalidad_resumen['normal_en_ambas_clases']).sum()}\")\n","\n","display(df_normalidad_resumen)"]},{"cell_type":"markdown","id":"f6KGspWtUMAs","metadata":{"id":"f6KGspWtUMAs"},"source":["## Visualización mediante histograma de una variable"]},{"cell_type":"code","execution_count":null,"id":"rF0aPNvbT2Cs","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":509},"executionInfo":{"elapsed":2781,"status":"ok","timestamp":1784564118686,"user":{"displayName":"JENIFER MACARENA BASUALDO","userId":"09586911832758242668"},"user_tz":180},"id":"rF0aPNvbT2Cs","outputId":"4bf596f1-b934-406a-e21c-209910ac7269"},"outputs":[{"data":{"image/png":"\n","text/plain":["\u003cFigure size 1200x500 with 2 Axes\u003e"]},"metadata":{},"output_type":"display_data"}],"source":["def plot_histograma_normalidad(df_wide, feature, df_normalidad_full, bins=40, figsize=(12, 5)):\n","    \"\"\"\n","    Histograma + KDE + curva normal teórica superpuesta, por clase,\n","    para inspeccionar visualmente la normalidad de una feature puntual.\n","    \"\"\"\n","    fig, axes = plt.subplots(1, 2, figsize=figsize, sharey=False)\n","    clases = df_wide['Clase_Nombre'].unique()\n","    colores = {'Mano Izquierda': 'crimson', 'Mano Derecha': 'teal'}\n","\n","    for ax, clase in zip(axes, clases):\n","        valores = df_wide.loc[df_wide['Clase_Nombre'] == clase, feature].dropna().values\n","\n","        sns.histplot(valores, bins=bins, stat='density', color=colores.get(clase, 'gray'),\n","                     alpha=0.5, kde=True, ax=ax)\n","\n","        # --- Curva normal teórica con la media/std de los datos, para comparar contra el histograma ---\n","        x_rango = np.linspace(valores.min(), valores.max(), 200)\n","        curva_normal = stats.norm.pdf(x_rango, loc=np.mean(valores), scale=np.std(valores, ddof=1))\n","        ax.plot(x_rango, curva_normal, color='black', linestyle='--', linewidth=1.5, label='Normal teórica')\n","\n","        p_val = df_normalidad_full.loc[\n","            (df_normalidad_full['feature'] == feature) \u0026 (df_normalidad_full['clase'] == clase),\n","            'p_value_shapiro'\n","        ].values[0]\n","        es_normal = p_val \u003e ALPHA\n","\n","        ax.set_title(f\"{clase}\\nShapiro p={p_val:.4f} ({'Normal' if es_normal else 'No normal'})\",\n","                     fontsize=11, fontweight='bold')\n","        ax.set_xlabel(feature)\n","        ax.legend(fontsize=8)\n","\n","    fig.suptitle(f'Distribución de \"{feature}\" por clase', fontsize=14, fontweight='bold')\n","    plt.tight_layout()\n","    plt.show()\n","\n","# --- Ejemplo de uso ---\n","plot_histograma_normalidad(df_features_wide, \"power_band_4_Cz\", df_normalidad)"]},{"cell_type":"markdown","id":"osiBAK2xUtbd","metadata":{"id":"osiBAK2xUtbd"},"source":["### Visualización de todas las variables"]},{"cell_type":"code","execution_count":null,"id":"jqMCZ-x-T78W","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"elapsed":21480,"status":"ok","timestamp":1784564161972,"user":{"displayName":"JENIFER MACARENA BASUALDO","userId":"09586911832758242668"},"user_tz":180},"id":"jqMCZ-x-T78W","outputId":"28bb5ad7-1182-446e-8662-31d28ac3bdbb"},"outputs":[{"data":{"image/png":"\n","text/plain":["\u003cFigure size 1600x1500 with 18 Axes\u003e"]},"metadata":{},"output_type":"display_data"}],"source":["\n","def plot_grid_histogramas(df_wide, columnas_features, df_normalidad_full, n_cols=4, bins=30):\n","    \"\"\"\n","    Grid de histogramas (una celda por feature) con ambas clases superpuestas,\n","    para inspección rápida de normalidad de todas las features a la vez.\n","    \"\"\"\n","    n_feats = len(columnas_features)\n","    n_rows = math.ceil(n_feats / n_cols)\n","    colores = {'Mano Izquierda': 'crimson', 'Mano Derecha': 'teal'}\n","\n","    fig, axes = plt.subplots(n_rows, n_cols, figsize=(n_cols * 4, n_rows * 3))\n","    axes = axes.flatten()\n","\n","    for idx, feat in enumerate(columnas_features):\n","        ax = axes[idx]\n","        for clase in df_wide['Clase_Nombre'].unique():\n","            valores = df_wide.loc[df_wide['Clase_Nombre'] == clase, feat].dropna().values\n","            sns.histplot(valores, bins=bins, stat='density', color=colores.get(clase, 'gray'),\n","                         alpha=0.4, kde=True, ax=ax, label=clase)\n","\n","        normal_ambas = df_normalidad_full.groupby('feature')['es_normal'].all().get(feat, False)\n","        ax.set_title(f\"{feat}\\n{'Normal' if normal_ambas else 'No normal'}\", fontsize=9)\n","        ax.set_xlabel('')\n","        ax.set_ylabel('')\n","        if idx == 0:\n","            ax.legend(fontsize=7)\n","\n","    # --- Ocultar ejes sobrantes si n_feats no completa el grid ---\n","    for idx in range(n_feats, len(axes)):\n","        fig.delaxes(axes[idx])\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","# --- Ejemplo: grillas por bloque, para no saturar una sola figura gigante ---\n","# Podés filtrar por prefijo (ej. solo las de banda de frecuencia, o solo AR)\n","cols_ejemplo = [c for c in columnas_features_todas if c.startswith('power_band')]\n","plot_grid_histogramas(df_features_wide, cols_ejemplo, df_normalidad)"]}],"metadata":{"colab":{"name":"","provenance":[{"file_id":"1e0pxWyFIl2zaWxx5yfP9xrIW4VR-tQXj","timestamp":1784490567725}],"version":""},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":5}