ive/MyDrive/BCI-MENTORIA-UNC'\n","    print(\"-\u003e Entorno Local PC.\")\n","\n","import mne\n","mne.set_log_level('ERROR')\n","from src.eeg_datasets.preprocessed_dataset import PreprocessedDataset\n","\n","sns.set_theme(style=\"whitegrid\")\n","plt.rcParams['figure.figsize'] = [12, 5]\n","\n","def binarize_y(y):\n","    unique_classes = np.unique(y)\n","    assert len(unique_classes) == 2, \"y debe tener exactamente dos clases distintas\"\n","    class_to_bin = {unique_classes[0]: 0, unique_classes[1]: 1}\n","    bin_to_class = {v: k for k, v in class_to_bin.items()}\n","    y_bin = np.vectorize(class_to_bin.get)(y)\n","    return y_bin, bin_to_class\n","\n","print(\"✅ ETAPA 0 — Entorno listo\")\n","\n","# ----------------------------------------------------------------------------\n","# ETAPA 1 — Dataset (Dreyer2023A, todos los sujetos)\n","# ----------------------------------------------------------------------------\n","try:\n","    DB_SELECCIONADA = \"Dreyer2023A\"\n","    CHANNELS = [\"C3\", \"Cz\", \"C4\"]\n","    SESSIONS = [\"session_1\"]\n","    DATA_TO_LOAD = [\"motor_imagery\"]\n","    SFREQ = 128\n","\n","    dataset = PreprocessedDataset(db_name=DB_SELECCIONADA, sessions=SESSIONS,\n","                                    subjects=None, data_to_load=DATA_TO_LOAD, channels=CHANNELS)\n","    lista_sujetos = dataset.get_subjects_list()\n","    print(f\"✅ ETAPA 1 — dataset instanciado, {len(lista_sujetos)} sujetos\")\n","except Exception as e:\n","    print(f\"⚠️ ETAPA 1 incompleta: {e}\")"]},{"cell_type":"markdown","id":"dvtkJPCuIOZz","metadata":{"id":"dvtkJPCuIOZz"},"source":[" # 📌 Nota introductoria — Cómo usar esta notebook (Fase 1: EDA y Extracción de Características)\n","\n","Esta notebook contiene la extracción de características multidominio para los 60 sujetos de Dreyer2023A y su visualización exploratoria (boxplots, PCA, t-SNE, UMAP, test de normalidad).\n","\n","No es necesario re-extraer las features desde cero. Alcanza con ejecutar la celda de